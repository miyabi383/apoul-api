# APOUL Worker — 本番（Render Background Worker 等）
FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.base.json ./
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY packages packages

RUN pnpm install --frozen-lockfile --prod=false && pnpm db:generate

ENV NODE_ENV=production
ENV WORKER_POLL_MS=2000
ENV WORKER_HEALTH_PORT=4200

WORKDIR /app/apps/worker
CMD ["sh", "-c", "cd /app && pnpm db:generate && exec ./node_modules/.bin/tsx src/main.ts"]
