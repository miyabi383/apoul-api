DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apoul?schema=public
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-strong-passw0rd
SEED_BILLING_MAPPING=true
BILLING_BASE_URL=http://localhost:4101/mock/billing
APOUL_API_URL=http://localhost:4100
APOUL_SERVICE_TOKEN=
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
PORT=4100
ALLOW_LOCAL_DISPATCH=true

# 開発専用: true でログイン・middleware をバイパス
# ⚠ production では AUTH_DISABLED=true は起動拒否されます
AUTH_DISABLED=true

# Rate limit（省略時はデフォルト値を使用）
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# EVENTS_RATE_LIMIT_MAX=120
# EVENTS_RATE_LIMIT_WINDOW_MS=60000

# Worker（Phase 3）
# WORKER_POLL_MS=1000
# WORKER_HEALTH_PORT=4200

# --- DB 起動（Docker）---
# docker compose up -d
# bash scripts/setup-local.sh

# --- Service Token 発行 ---
# pnpm issue-key -- contract "jobs:read,jobs:retry,..."
# events:write は管理画面用キーに含めないこと
